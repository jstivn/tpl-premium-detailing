{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tpl-premium-detailing",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git",
      ".git/**",
      ".github/**",
      "server.js",
      "README.md",
      "assets_map.json"
    ]
  }
}
